# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Gradle / Android (convey/) -- local.properties carries a machine-local SDK path, .gradle/ is
# the build cache, and *.iml/.idea are IDE-generated.
.gradle/
local.properties
*.iml
.idea/
.kotlin/
kotlin-js-store/
